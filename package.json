{
  "name": "driveease",
  "private": true,
  "version": "1.0.0",
  "description": "DriveEase - Premium Luxury Car Rental & Exotic Vehicle Fleet Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "predeploy": "npm run build",
